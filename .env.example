# PakMobileSpec — Environment Variables Template
# Copy this file to .env and customize for production deployment. Do NOT commit .env to version control.

# Server Host & Port (Cloud platforms automatically inject PORT)
HOST=0.0.0.0
PORT=8000

# Cryptographic HMAC Secret for signing Admin Session Cookies (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
PAK_MOBILE_SECRET=replace-with-64-char-random-hex-secret

# Optional Custom SQLite Database Path (Defaults to ./mobile_hub.db)
# On persistent cloud volume mounts (e.g. Fly.io / Render Disk), set to /data/mobile_hub.db
PAK_MOBILE_DB_PATH=mobile_hub.db

# Administrator Credentials Configuration
PAK_MOBILE_ADMIN_USER=admin
# Generate a hash safely using: python manage_admin.py --hash-only --password "YourStrongPassword"
PAK_MOBILE_ADMIN_HASH=
